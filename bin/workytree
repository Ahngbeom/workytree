#!/usr/bin/env zsh
# workytree — git worktree manager. Pure CLI: computes paths, calls git, prints. Never cd's.
set -u
setopt extendedglob
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin:${PATH:-}"

typeset -g WORKYTREE_VERSION="0.2.0"
typeset -g WORKYTREE_HOME="${0:A:h:h}"   # :A resolves the ~/.local/bin symlink

# The shell wrapper (shell/workytree.zsh) mktemps a runfile and exports its path into our
# environment as WORKYTREE_AI_RUNFILE on EVERY `create` -- it cannot know in advance whether
# this run will actually use it (feature on or off, --ai or not). Left exported, every
# process we spawn from here on would inherit it too, including `git worktree add`'s
# post-checkout hook -- a hook that already runs as the user, but as an unattended, captured
# subprocess, not as a command meant to run in the user's foreground interactive shell.
# Measured: with the feature untouched (default config, no --ai), a repo's post-checkout hook
# writing `/bin/echo SOMETHING` into $WORKYTREE_AI_RUNFILE got that command executed in the
# calling shell after the cd -- on a plain `create` that never asked for an AI session.
# Capture the value into our own name and remove the original from the environment before any
# git invocation, so no descendant process ever sees the path. `typeset -g` alone would leave
# WT_AI_RUNFILE exported if a caller happened to already have that name exported (it preserves
# an existing export attribute, not just the value) -- measured: a `post-checkout` hook on a
# plain `wt create -y` then saw WORKYTREE_AI_RUNFILE=[] but WT_AI_RUNFILE=[...the path...],
# reopening the exact leak this capture exists to close. `+x` on the same typeset clears the
# export attribute unconditionally, regardless of what the caller's shell had set.
typeset -g +x WT_AI_RUNFILE="${WORKYTREE_AI_RUNFILE:-}"
unset WORKYTREE_AI_RUNFILE
# Set by shell/workytree.zsh only when it will cd to the path `remove` or `status` prints last.
typeset -gi +x WT_CAN_CD=0
[[ "${WORKYTREE_CD_CAPABLE:-}" == 1 ]] && WT_CAN_CD=1
unset WORKYTREE_CD_CAPABLE

typeset -g  WT_PROJECT_OPT=""
typeset -gi WT_YES=0
typeset -ga ARGS

local f
for f in "$WORKYTREE_HOME"/lib/*.zsh(N) "$WORKYTREE_HOME"/lib/cmd/*.zsh(N); do
  source "$f"
done

usage() {
  cat <<'EOF'
Usage: workytree <command> [args] [--project <name>] [--yes|-y] [--no-color]

  workytree init [name repo_root worktree_root]          interactive first-time setup
  workytree create [--ai] [repo] [kind] [ticket] [base]  create (or reuse) a worktree; asks for missing args
  workytree remove [repo] [kind] [ticket] [--force] [-b|--branch] [-B|--branch-force]
                  [-r|--remote] [--to <dir>]                picks a worktree and asks about branches/destination when interactive
  workytree prune [repo]                                 prune stale refs + orphan dirs
  workytree list [repo]                                  git worktree list per repo
  workytree status [repo] [--fetch|--offline] [--stale [days]] [--json] [--plain]
                                                         worktree/branch overview; fzf list when available
  workytree repos                                        repos across all projects
  workytree path [repo [kind [ticket]]]                  print a path (script-friendly)
  workytree cd   [repo [kind [ticket]]]                  cd (shell integration only)
  workytree project list|add <name> <repo_root> <worktree_root>|remove <name>|default <name>
  workytree repo    list|add <path> [--name n] [--project p]|remove <name>
  workytree config  path|get <key>|set <key> <value>|edit
  workytree help | --version
EOF
}

parse_global_opts() {
  ARGS=()
  while (( $# )); do
    case "$1" in
      --project)   shift; [[ $# -gt 0 ]] || usage_error "--project requires a name"; WT_PROJECT_OPT="$1" ;;
      --project=*) WT_PROJECT_OPT="${1#--project=}" ;;
      --yes|-y)    WT_YES=1 ;;
      --no-color)  WT_COLOR=0 ;;
      *)           ARGS+=("$1") ;;
    esac
    shift
  done
}

main() {
  parse_global_opts "$@"
  ui_init
  config_load
  set -- "${ARGS[@]}"
  (( $# )) || { usage >&2; exit 2; }
  local command="$1"; shift
  case "$command" in
    help|-h|--help) usage ;;
    --version|version) print -r -- "workytree $WORKYTREE_VERSION" ;;
    init|create|remove|prune|list|status|repos|path|cd|project|repo|config|__complete|__ai-configured|__status-rows|__status-preview|__status-action)
      (( $+functions[cmd_$command] )) || die "command not implemented yet: $command"
      "cmd_$command" "$@" ;;
    *) usage >&2; usage_error "unknown command: $command" ;;
  esac
}

main "$@"
